#!/bin/bash
set -e

# ---------------------------------------------------------------------------
# cratecaddy — CrateCaddy appliance manager (MongoDB + API daemon)
#
# WHAT THIS IS
#   CrateCaddy is a music metadata explorer. This script runs it as a
#   self-contained "appliance" on macOS: a MongoDB container (via Docker
#   Compose) plus the built API process (Node, serving the static UI).
#
#   It targets the PRODUCTION build. The prod stack uses distinct defaults so
#   it never collides with the dev setup (Vite dev server + npm run dev API):
#     prod API  port -> 5225   (dev uses 5326)
#     prod Mongo port -> 5227   (dev uses 5327)
#
# COMMANDS
#   cratecaddy start        Start MongoDB container + API daemon
#   cratecaddy stop         Stop the API and take the MongoDB container down
#   cratecaddy restart      Stop then start
#   cratecaddy status       Is the API running? (reads ~/.cratecaddy/api.pid)
#   cratecaddy logs         Tail the API log file
#   cratecaddy import [prod|dev] <xml-file>   Import an Apple Music XML library
#                           (default target = $CRATECADDY_ENV from config.env)
#   cratecaddy install      Install the runtime to ~/.cratecaddy, add the CLI
#                           to PATH, and enable auto-start on boot (launchd)
#   cratecaddy uninstall    Remove auto-start + PATH line, stop all services
#
# CONFIG (all optional, sourced from ~/.cratecaddy/config.env if it exists)
#   CRATECADDY_ENV  prod|dev   default target for `import` (default: prod)
#   API_PORT        prod API port (default: 5225)
#   MONGO_PORT      prod Mongo host port (default: 5227)
#   CRATECADDY_LOG  API log file (default: ~/.cratecaddy/cratecaddy.log)
#
# LAYOUT
#   ~/.cratecaddy/           the appliance — installed runtime + runtime state
#     bin/cratecaddy         this CLI
#     docker-compose.yml     base compose (dev: name cratecaddy-dev)
#     docker-compose.prod.yml  prod override (name cratecaddy-prod)
#     macos/                 launchd plist template
#     src/api/               built API (dist/ + node_modules/ + scripts)
#     config.env             optional config
#     cratecaddy.log         API log
#     api.pid                API PID file
#
#   The CLI resolves everything from its own location ($PROJECT_DIR, two levels
#   up from bin/), so after `install` the copied script runs against the copy in
#   ~/.cratecaddy — the checkout is no longer needed.
#
# INSTALLATION
#   Clone the repo, npm install in src/ui and src/api, run `./scripts/build-prod.sh`,
#   then run this script's `install` command from the checkout. It copies the
#   built runtime into ~/.cratecaddy, adds the CLI to PATH via ~/.zshrc, and
#   installs the launchd plist for boot auto-start. Docker must be running.
# ---------------------------------------------------------------------------

# Config — source ~/.cratecaddy/config.env if it exists (dotenv-style KEY=VALUE
# lines, valid shell). Sourcing makes every value visible to this script and to
# the env vars we export into child processes below.
CONFIG="$HOME/.cratecaddy/config.env"
[ -f "$CONFIG" ] && . "$CONFIG"

# Prod defaults are deliberately distinct from the dev defaults (dev: API 5326,
# Mongo 5327 from the root .env / README). Prod runs on its own ports so the
# two environments never collide on one host.
API_PORT="${API_PORT:-5225}"
MONGO_PORT="${MONGO_PORT:-5227}"
MONGO_CONTAINER="cratecaddy-mongodb-prod"
INSTALL_ROOT="$HOME/.cratecaddy"
LOG_FILE="${CRATECADDY_LOG:-$INSTALL_ROOT/cratecaddy.log}"
PID_FILE="$INSTALL_ROOT/api.pid"

# Follow any symlink chain to the real file before computing SCRIPT_DIR, so
# PROJECT_DIR is derived from the actual script location (the installed copy at
# ~/.cratecaddy/bin) even if the user creates a shortcut to it. BSD readlink has
# no -f, hence the loop.
resolve_script() {
  local source="$1"
  while [ -L "$source" ]; do
    local dir target
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    case "$target" in
      /*) source="$target" ;;
      *)  source="$dir/$target" ;;
    esac
  done
  echo "$source"
}

REAL_SCRIPT="$(resolve_script "$0")"
SCRIPT_DIR="$(cd -P "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

start_mongodb() {
  # At OS boot, launchd may fire `cratecaddy start` before Docker Desktop is up.
  # Wait for the daemon (bounded) instead of failing instantly under set -e.
  echo "Waiting for Docker..."
  local dtries=0
  until docker info > /dev/null 2>&1; do
    dtries=$((dtries + 1))
    if [ "$dtries" -ge 60 ]; then
      echo "ERROR: Docker daemon is not reachable after 60s. Start Docker and re-run." >&2
      exit 1
    fi
    sleep 1
  done
  # `docker compose up -d` is idempotent: if the container is already up it
  # prints "running" and exits 0, so no separate already-running guard is needed.
  # Export MONGO_PORT so compose interpolates a custom value from config.env:
  # `docker compose` only reads the process environment, and sourcing config.env
  # sets shell vars that are NOT exported — without this, the container would
  # publish the default port while start_api connects to the custom one.
  export MONGO_PORT
  docker compose -f "$PROJECT_DIR/docker-compose.yml" -f "$PROJECT_DIR/docker-compose.prod.yml" up -d
  echo "Waiting for MongoDB..."
  # mongosh runs inside the container (it ships with mongo:7.0), so no host
  # mongosh prerequisite. Port inside the container is always 27017 — the host
  # mapping is external. Give up after 60s so a dead Docker daemon fails the
  # command instead of hanging forever.
  local tries=0
  until docker exec "$MONGO_CONTAINER" mongosh --quiet --port 27017 --eval 'db.runCommand("ping").ok' > /dev/null 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -ge 60 ]; then
      echo "ERROR: MongoDB did not become ready within 60s. Is Docker running?" >&2
      exit 1
    fi
    sleep 1
  done
  echo "MongoDB ready on port $MONGO_PORT."
}

start_api() {
  cd "$PROJECT_DIR/src/api"
  # Export the resolved prod config into the Node process. The API's shared
  # config module (src/api/src/config/env.ts) reads MONGODB_URI and API_PORT
  # from the environment and only falls back to the repo .env for dev, so these
  # exports always win and custom ports take effect.
  export NODE_ENV=production
  export API_PORT
  export MONGODB_URI="mongodb://127.0.0.1:${MONGO_PORT}/cratecaddy"
  nohup node dist/server.js > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  echo "API started on port $API_PORT (PID: $(cat $PID_FILE))"
}

stop_api() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
}

case "${1:-}" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "CrateCaddy is already running on port $API_PORT."
      exit 0
    fi
    mkdir -p "$(dirname "$LOG_FILE")"
    start_mongodb
    start_api
    echo ""
    echo "CrateCaddy is running: http://localhost:$API_PORT"
    ;;
  stop)
    stop_api
    docker compose -f "$PROJECT_DIR/docker-compose.yml" -f "$PROJECT_DIR/docker-compose.prod.yml" down 2>/dev/null || true
    echo "CrateCaddy stopped."
    ;;
  restart)
    stop_api
    docker compose -f "$PROJECT_DIR/docker-compose.yml" -f "$PROJECT_DIR/docker-compose.prod.yml" down 2>/dev/null || true
    sleep 1
    mkdir -p "$(dirname "$LOG_FILE")"
    start_mongodb
    start_api
    echo ""
    echo "CrateCaddy restarted: http://localhost:$API_PORT"
    ;;
  status)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "CrateCaddy is running on port $API_PORT (PID: $(cat $PID_FILE))"
    else
      echo "CrateCaddy is not running."
      rm -f "$PID_FILE" 2>/dev/null
    fi
    ;;
  logs)
    tail -f "$LOG_FILE"
    ;;
  import)
    # Consume the "import" subcommand word so $1 becomes the first real arg.
    shift
    # Target environment. Explicit positional arg wins; otherwise the
    # CRATECADDY_ENV prop from config (prod for the installed daemon).
    ENV_TARGET="${CRATECADDY_ENV:-prod}"
    case "${1:-}" in
      prod|dev)
        ENV_TARGET="$1"
        shift
        ;;
      *)
        : # $1 is the file path, not an env target
        ;;
    esac
    # Load the target env's config, then export MONGODB_URI so the host-side
    # import script (whose shared config module reads process.env.MONGODB_URI,
    # default localhost:27017) connects to the right database on the right port.
    # The URI is always derived from the resolved MONGO_PORT — never trusted from
    # the config file — so the port and the URI cannot drift apart.
    if [ "$ENV_TARGET" = "dev" ]; then
      # Dev defaults independently of prod config (which was sourced at the top):
      # .env may override these, but a missing value must NOT inherit prod's.
      API_PORT=5326
      MONGO_PORT=5327
      [ -f "$PROJECT_DIR/.env" ] && . "$PROJECT_DIR/.env"
    fi
    export MONGODB_URI="mongodb://127.0.0.1:${MONGO_PORT}/cratecaddy"
    # Debug line: shows the target so a wrong-environment whoops can be Ctrl-C'd.
    echo "Importing to $ENV_TARGET ($MONGODB_URI)..."
    cd "$PROJECT_DIR/src/api"
    npm run import:applemusic "$@"
    ;;
  install)
    # Install the built runtime into ~/.cratecaddy so the appliance no longer
    # depends on the checkout. Everything the CLI needs at runtime — the compose
    # files, the launchd template, and the built API (dist/ + node_modules/ +
    # scripts) — is copied. The copied CLI resolves $PROJECT_DIR from its own
    # location, so start/stop/import then run against the copy.
    if [ "$PROJECT_DIR" != "$INSTALL_ROOT" ]; then
      if [ ! -f "$PROJECT_DIR/src/api/dist/server.js" ]; then
        echo "ERROR: no production build found (src/api/dist/server.js missing)." >&2
        echo "Run ./scripts/build-prod.sh first, then re-run install." >&2
        exit 1
      fi
      echo "Copying the CrateCaddy runtime to $INSTALL_ROOT ..."
      mkdir -p "$INSTALL_ROOT/bin" "$INSTALL_ROOT/macos"
      cp "$PROJECT_DIR/bin/cratecaddy" "$INSTALL_ROOT/bin/cratecaddy"
      chmod +x "$INSTALL_ROOT/bin/cratecaddy"
      cp "$PROJECT_DIR/docker-compose.yml" "$PROJECT_DIR/docker-compose.prod.yml" "$INSTALL_ROOT/"
      cp "$PROJECT_DIR/macos/com.cratecaddy.startup.plist" "$INSTALL_ROOT/macos/"
      rm -rf "$INSTALL_ROOT/src/api"
      # BSD cp -R fails if the destination's parent (…/src) does not exist, so
      # pre-create it and copy the contents rather than the directory itself.
      mkdir -p "$INSTALL_ROOT/src/api"
      cp -R "$PROJECT_DIR/src/api/." "$INSTALL_ROOT/src/api/"
      # One PATH line in ~/.zshrc so `cratecaddy` resolves anywhere. Idempotent:
      # a full-line grep guard means re-running install never duplicates it.
      # Create ~/.zshrc if missing (fresh accounts may not have one).
      if [ ! -f "$HOME/.zshrc" ]; then
        touch "$HOME/.zshrc"
      fi
      if ! grep -qF 'export PATH="$HOME/.cratecaddy/bin:$PATH"' "$HOME/.zshrc"; then
        {
          echo ""
          echo "# cratecaddy CLI"
          echo 'export PATH="$HOME/.cratecaddy/bin:$PATH"'
        } >> "$HOME/.zshrc"
      fi
      echo "Runtime installed. Open a new terminal (or run 'source ~/.zshrc') to use 'cratecaddy'."
    fi
    # Bake the installed CLI path and log file path into the plist. The plist
    # always references the installed copy ($INSTALL_ROOT/bin/cratecaddy), never
    # the checkout, so auto-start survives the checkout being moved or removed.
    # The installed copy is frozen config — changing config.env afterwards does
    # not rewrite it; re-run `install` to regenerate.
    mkdir -p ~/Library/LaunchAgents
    sed -e "s|__CRATECADDY_CLI_PATH__|$INSTALL_ROOT/bin/cratecaddy|" \
        -e "s|__CRATECADDY_LOG_FILE__|$LOG_FILE|" \
      "$INSTALL_ROOT/macos/com.cratecaddy.startup.plist" \
      > ~/Library/LaunchAgents/com.cratecaddy.startup.plist
    launchctl load ~/Library/LaunchAgents/com.cratecaddy.startup.plist
    echo "Auto-start enabled. CrateCaddy will start on boot."
    ;;
  uninstall)
    launchctl unload ~/Library/LaunchAgents/com.cratecaddy.startup.plist 2>/dev/null || true
    rm -f ~/Library/LaunchAgents/com.cratecaddy.startup.plist
    stop_api
    docker compose -f "$PROJECT_DIR/docker-compose.yml" -f "$PROJECT_DIR/docker-compose.prod.yml" down 2>/dev/null || true
    # Remove the PATH line added by install (leave the rest of ~/.zshrc alone).
    if [ -f "$HOME/.zshrc" ]; then
      sed -i '' -e '/^# cratecaddy CLI$/d' -e '/^export PATH="\$HOME\/\.cratecaddy\/bin:\$PATH"$/d' "$HOME/.zshrc"
    fi
    echo "CrateCaddy uninstalled. The runtime in ~/.cratecaddy and the prod data volume are kept."
    echo "To remove them too: rm -rf ~/.cratecaddy && docker volume rm cratecaddy-mongo-data-prod"
    ;;
  *)
    echo "CrateCaddy — music metadata explorer"
    echo ""
    echo "Usage: cratecaddy <command>"
    echo ""
    echo "Commands:"
    echo "  start             Start CrateCaddy (MongoDB + API)"
    echo "  stop              Stop all services"
    echo "  restart           Restart all services"
    echo "  status            Check if CrateCaddy is running"
    echo "  logs              Tail API log file"
    echo "  import <path>     Import from Apple Music XML"
    echo "  install           Install runtime to ~/.cratecaddy + enable auto-start"
    echo "  uninstall         Remove auto-start + PATH line, stop services"
    ;;
esac
